# Prevent production .env file from being copied to Docker container
# (We'll create a minimal build .env instead)
.env
!.env.docker-build

# Docker files
docker-compose*.yml
Dockerfile*

# Development files
.git
.gitignore
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Coverage directory used by tools like istanbul
coverage
*.lcov

# Build output
dist
build

# Temporary files
.tmp
.cache

# Planning records and disposable test fixtures.
# Note this is `tmp`, not `.tmp` above; they are different directories.
tmp

# Tests. Excluding them from the build context is what keeps them out of the
# published image: the builder does `COPY . .`, and the production stage then
# copies /app/src wholesale for the entrypoint's database utilities.
src/tests
tests
vitest.config.js
playwright.config.js

# Test stack and fixture seeding: developer-local, and the seed scripts carry
# fixture passwords that have no business in a published image.
scripts/testing

# Documentation and CI config are not needed at build or run time.
# .github in particular is ~13 MB of screenshots.
docs
.github
Makefile
*.md

# Exception: CHANGELOG.md is needed at BUILD time. `src/lib/changelog.server.js`
# imports it with Vite's `?raw`, which inlines the release history into the bundle
# so the About popup does not have to read a file the production image never
# copies. Without this line the build fails outright, which is how this was
# found. Do not remove it without removing that import.
!CHANGELOG.md