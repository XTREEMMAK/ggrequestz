# =================================
# GG Requestz Configuration
# Copy this file to .env and update with your values
# =================================

# =================================
# DOCKER USER/GROUP IDS (for proper file permissions)
# =================================
PUID=1000
PGID=1000
TZ=America/New_York

# =================================
# REQUIRED CONFIGURATION
# =================================

# Public Site URL (used for API documentation and external links)
# Include protocol (http:// or https://) and domain/port
PUBLIC_SITE_URL=http://localhost:3000

# The origin adapter-node treats as canonical. REQUIRED behind a reverse proxy:
# form submissions are rejected as cross-site when the browser's Origin header
# does not match, and OIDC redirect URIs are built from it. Set it to the URL
# users actually type. Defaults to PUBLIC_SITE_URL in the Docker entrypoint.
ORIGIN=http://localhost:3000

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ggrequestz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme123

# Maximum connections in the pg pool, per PM2 worker. With PM2_INSTANCES=max
# the real ceiling is this number multiplied by your CPU core count, so raise
# Postgres's own max_connections to match before increasing it.
#POSTGRES_POOL_MAX=10

# Authentication Method: oidc | oidc_generic | authentik | basic
# (the first three are equivalent and all select OIDC/SSO)
AUTH_METHOD=basic

# OIDC / SSO (required when AUTH_METHOD is oidc, oidc_generic or authentik)
#
# Works with any standards-compliant provider: Keycloak, Pocket ID, Authentik,
# Auth0, Okta, Entra ID. Endpoints are discovered from
# <OIDC_ISSUER_URL>/.well-known/openid-configuration.
# See docs/setup/OIDC_SETUP.md.
OIDC_ISSUER_URL=https://id.yourdomain.com/realms/main
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret

# Label on the login button, rendered as "Login with <name>". Default: SSO
OIDC_PROVIDER_NAME=SSO

# Strongly recommended. Behind a reverse proxy the app cannot reliably infer
# whether it is served over http or https, and a mismatched scheme makes the
# provider reject the login with a redirect_uri error.
OIDC_REDIRECT_URI=https://requests.yourdomain.com/api/auth/callback

# Optional: role mapping from provider groups. If the provider sends no groups
# claim, locally assigned roles are left untouched.
#OIDC_SCOPES=openid email profile groups
#OIDC_GROUPS_CLAIM=groups
#OIDC_ROLE_MAP=my-admins:admin,my-staff:manager,my-users:viewer

# Optional: members of this group are granted admin. Simpler alternative to
# OIDC_ROLE_MAP when you only need to distinguish admins from everyone else.
#OIDC_ADMIN_GROUP=

# Optional: manual endpoints for providers without a discovery document.
#OIDC_AUTH_URL=
#OIDC_TOKEN_URL=
#OIDC_USERINFO_URL=
#OIDC_JWKS_URI=
#OIDC_END_SESSION_URL=

# Legacy aliases, still supported so existing Authentik installs keep working.
#AUTHENTIK_CLIENT_ID=
#AUTHENTIK_CLIENT_SECRET=
#AUTHENTIK_ISSUER=https://auth.yourdomain.com/application/o/ggrequestz

# Session Secret (generate a random 64-character string for production)
# REQUIRED. Signs session cookies; the app refuses to start without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_random_session_secret_here_64_chars_minimum_for_production

# IGDB API Credentials (required for game data)
# Get these from: https://dev.twitch.tv/console
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# =================================
# OPTIONAL SERVICES
# =================================

# Redis Cache (recommended for production)
REDIS_URL=redis://redis:6379

# Only honoured by docker-compose.production.yml. The default docker-compose.yml
# hardcodes 256mb, so setting this alone has no effect on the standard stack.
REDIS_MAX_MEMORY=512mb

# Gotify Push Notifications (optional)
GOTIFY_URL=https://gotify.yourdomain.com
GOTIFY_TOKEN=your_gotify_token

# ROMM Game Library Integration (optional)
#
# Prefer an internal hostname (e.g. http://romm:8080) over a public URL. A
# public URL sends every request out through DNS, TLS and your reverse proxy
# and back, which is slower and more failure-prone.
ROMM_SERVER_URL=https://romm.yourdomain.com

# Browser-facing ROMM URL, used for "Play in ROMM" links, the library nav link
# and ROMM cover images. Only needed when ROMM_SERVER_URL is an address the
# browser cannot reach: a Kubernetes service name, a Docker network alias.
# Defaults to ROMM_SERVER_URL.
#ROMM_SERVER_URL_PUBLIC=https://romm.yourdomain.com

# RECOMMENDED (RomM 5.0+): a Client API Token, created in the RomM admin UI
# under your user's API tokens. Must include the "roms.read" scope.
# Using this avoids storing your ROMM password and avoids the 30-minute token
# expiry of the password grant.
ROMM_API_TOKEN=

# Fallback for RomM 4.x, or if you are not using a Client API Token.
# Note: the account must have library read permission ("roms.read"). RomM
# issues a token containing only the scopes the account actually holds, so an
# under-privileged account logs in successfully and then gets 403 on every
# library request.
ROMM_USERNAME=your_romm_username
ROMM_PASSWORD=your_romm_password

# Game library, backend-neutral names. These are the preferred spelling of the
# ROMM_* settings above and take precedence over them; the ROMM_* names keep
# working, so there is nothing to change on an existing install.
#
# Every one of these is commented out deliberately. An uncommented
# LIBRARY_URL shadows whatever ROMM_SERVER_URL is set to above, which silently
# redirects the library away from the address the operator configured.
#
# LIBRARY_KIND selects the backend: romm (default), gaseous, retrom.
#
# For gaseous: there is no API token, so LIBRARY_USERNAME and LIBRARY_PASSWORD
# are both required, LIBRARY_USERNAME must be the account's e-mail address, and
# the account cannot have two-factor authentication enabled. Gaseous search
# matches a prefix rather than a substring until the library index below is
# enabled. See docs/guides/INTEGRATIONS.md.
#LIBRARY_KIND=romm
#LIBRARY_URL=http://romm:8080
# Where a browser should be sent, when that differs from the address above.
#LIBRARY_PUBLIC_URL=
#LIBRARY_API_TOKEN=
#LIBRARY_USERNAME=
#LIBRARY_PASSWORD=

# Local library index. A background pass asks the backend to enumerate itself
# and stores the result, so ordering, paging, searching and IGDB cross-reference
# are answered by SQL instead of by the backend.
#
# Off by default, and deliberately: enabling it means walking the whole library
# on a timer. With it off, reads fall back to the backend exactly as before.
# Enable it for a large RomM library, and for Retrom, which cannot answer an
# ordered, paged or searched query at all.
#
# Only the literal string "true" enables it.
#LIBRARY_SYNC_ENABLED=false
# How often a pass runs, in milliseconds. Default 900000 (15 minutes).
#LIBRARY_SYNC_INTERVAL_MS=900000
# Entries per batch. One database statement and one backend page per batch, so
# larger is fewer round trips and more memory per pass. Default 500.
#LIBRARY_SYNC_BATCH=500
# The largest share of the currently-indexed library that one completed pass
# is allowed to mark removed. Default 0.5.
#
# A pass only sweeps after enumerating the whole backend without throwing, so a
# partial or failed walk already sweeps nothing. This covers the other case: a
# backend that answers honestly and answers empty -- its own database reset, its
# ROM volume unmounted before a rescan, LIBRARY_URL repointed at a fresh
# instance. That pass completes, and without this every entry would be marked
# removed and the whole library would read as absent until the next good pass.
#
# Above the ratio the sweep is skipped entirely, the reason is written to
# ggr_library_sync_state.last_error, and the index is left as it was. A first
# sync has nothing live yet and can never trip it. Set to 1 to never refuse.
#LIBRARY_SYNC_MAX_SWEEP_RATIO=0.5

# Outbound Request Webhook (optional)
# Outbound webhook for request events. Any receiver that accepts JSON works --
# n8n, a download automation service, a script, a chat bridge.
# REQUEST_WEBHOOK_URL=https://automation.yourdomain.com/hook/game-request
#
# Deprecated alias, still honoured so existing installs keep working:
# N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/game-request

# =================================
# DOCKER CONFIGURATION
# =================================

# External Port Mapping (change if ports conflict)
APP_PORT=3000
POSTGRES_EXTERNAL_PORT=5432
REDIS_EXTERNAL_PORT=6380

# Run pending database migrations automatically on container start.
# Set to false to run them by hand with `npm run db:migrate`.
AUTO_MIGRATE=true

# Check GitHub for a newer release and show an indicator beside the version in
# the sidebar. Set to false on air-gapped installs, or anywhere the app should
# not reach out. The check is cached for six hours, backs off while it keeps
# failing, and never blocks a page render.
UPDATE_CHECK_ENABLED=true

# PM2 Process Management (max = use all CPU cores)
PM2_INSTANCES=max

# Optional cron expression to restart workers on a schedule, e.g. "0 4 * * *"
# for a nightly 04:00 restart. Unset means no scheduled restart.
#PM2_CRON_RESTART=

# =================================
# ADVANCED OPTIONS (use with caution)
# =================================

# Database Reset - WARNING: This will delete all data!
# RESET_DATABASE=true